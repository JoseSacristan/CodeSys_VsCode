{
    // Ruta al ejecutable y perfil instalados en esta VM (ver README.md -> "Si CODESYS se actualiza").
    "codesys.exePath": "C:\\Program Files\\CODESYS 3.5.14.10\\CODESYS\\Common\\CODESYS.exe",
    "codesys.profile": "CODESYS V3.5 SP14 Patch 1",

    // El proyecto (.project/.library) y la carpeta de .st con los que trabajas
    // NO van aqui: estan en rutas_codesys.json, en la raiz del repo (visible,
    // fuera de esta carpeta oculta). Los guarda la GUI y los leen las tareas.

    "files.associations": {
        "*.py": "python"
    },

    // CODESYS inyecta variables globales (system, projects, online, ...) al ejecutar el script,
    // por eso Pylance no puede resolverlas de forma estatica.
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportUndefinedVariable": "none",
        "reportMissingModuleSource": "none"
    }
}
